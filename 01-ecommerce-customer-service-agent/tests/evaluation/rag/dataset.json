  "sources": [
    {
      "source_id": "RAG-PAY",
      "title": "模拟账户支付",
      "body": "新顾客开户初始余额为0。模拟充值金额等额记入本人余额并记录流水；不涉及真实资金。购物从本人余额扣款。暂不支持提现和转账。",
      "source_revision": "REQ-CS-v0.2",
      "visibility": "public",
      "product_id": null
    },
    {
      "source_id": "RAG-ADDR",
      "title": "订单修改收货信息",
      "body": "发货成功前每个订单只允许成功修改一次地址。以店铺发货按钮对应的成功业务事件为界，发货后禁止改址。修改成功后显示地址已修改，次数不能通过刷新页面或更换会话重置。改址后保留普通取消入口，执行仍需核对业务状态。",
      "source_revision": "REQ-CS-v0.2",
      "visibility": "public",
      "product_id": null
    },
    {
      "source_id": "RAG-RECEIPT",
      "title": "运输与确认收货",
      "body": "发货后订单进入运输中。承运签收不等于顾客本人确认收货。正式售后仅在本人确认收货后开放。运输中保留物流查询、催件、拦截和丢件工单；异常退款需顾客确认诉求、获分派客服核验责任，争议交主管处理。不得要求顾客虚假确认收货。",
      "source_revision": "REQ-CS-v0.2",
      "visibility": "public",
      "product_id": null
    },
    {
      "source_id": "RAG-RETURN",
      "title": "收到商品后的退货退款",
      "body": "普通退货须在顾客本人确认收货后7×24小时内申请，客服审核后顾客填写退货物流，店铺核验收到退货后退款入本人余额。审核通过或填写退货单号不代表退款到账。超期、退货丢件及争议由主管处理。",
      "source_revision": "REQ-CS-v0.2",
      "visibility": "public",
      "product_id": null
    },
    {
      "source_id": "RAG-PARTIAL",
      "title": "部分数量与运费",
      "body": "顾客可以按订单明细和数量申请部分退货退款。退款按对应商品原实付分摊，累计不得超过剩余可退数量和金额，顾客不能填写任意退款额。普通退货不退原订单运费。质量问题或错发经客服核实后按订单适用政策核算商品及运费，退货寄回运费只记录责任方，不模拟新的收费系统。",
      "source_revision": "REQ-CS-v0.2",
      "visibility": "public",
      "product_id": null
    },
    {
      "source_id": "RAG-PRIVACY",
      "title": "本人及客服信息范围",
      "body": "游客可访问公开商品与政策；登录顾客保留公开访问权并可查本人业务数据。人工客服限获分派会话或工单关联数据。客服和主管只能看电话末四位、地址到市，后续用星号遮盖，没有解密入口；接口、导出、日志和模型上下文都遵守此限制。顾客本人获准个人页面可以看完整收货信息。",
      "source_revision": "REQ-CS-v0.2",
      "visibility": "public",
      "product_id": null
    },
    {
      "source_id": "RAG-APPROVAL",
      "title": "权限与售后审批",
      "body": "退款申请需顾客确认；获分派客服审核，主管处理争议和规则例外，智能客服没有退款审批权。店铺管理员负责发货、核验收到退货和维护商品售价库存，角色不能直接改用户余额。成功支付、退款或模拟充值通过受控业务形成一致流水。",
      "source_revision": "REQ-CS-v0.2",
      "visibility": "public",
      "product_id": null
    }
  ],
