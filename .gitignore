# This repository publishes the three projects and their portable documentation.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/docs/
!/scripts/
!/01-ecommerce-customer-service-agent/
!/02-ecommerce-operations-agent/
!/03-ecommerce-text2sql-finetuning/

# Local environments, models, secrets and generated state stay on this machine.
**/.runtime/
**/.venv*/
**/venv/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.agents/
**/.query-*/
**/dist/
**/build/
**/*.egg-info/
**/test-results/
**/playwright-report/
**/coverage/
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
**/*private*.json
**/*credential*.json
**/HANDOFF.MD
**/README.history.local.md
*.pyc
*.pyo
*.log
*.db
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.pem
*.key
*.safetensors
*.gguf
*.ckpt
*.pt
*.pth
*.bin
*.zip
*.7z
*.tar
*.tar.gz

# Machine-specific execution archives remain intact locally. See docs/STATUS.md.
**/docs/07-iteration/
**/docs/06-acceptance/
**/docs/**/evidence/
**/docs/**/review-output/
**/docs/**/pytest-temp/
**/docs/**/pytest-final-temp/

# External downloaded corpora, generated runs and database clusters are reproducible inputs/state.
/03-ecommerce-text2sql-finetuning/data/raw/
/03-ecommerce-text2sql-finetuning/data/public_sft/
/03-ecommerce-text2sql-finetuning/data/eval_archive/
/03-ecommerce-text2sql-finetuning/data/sft_v1_rebuild/
/03-ecommerce-text2sql-finetuning/data/sft_mixed/
/03-ecommerce-text2sql-finetuning/outputs/
/03-ecommerce-text2sql-finetuning/sandbox/pgdata/
/03-ecommerce-text2sql-finetuning/sandbox/results/
